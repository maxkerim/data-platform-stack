# Скопируйте в .env и замените значения: cp .env.example .env
# Пароли только из букв и цифр (спецсимволы ломают строки подключения).
# .env в Git не коммитится (см. .gitignore).

# UID пользователя на хосте. На Linux: AIRFLOW_UID=$(id -u). На Windows/Mac оставьте 50000.
AIRFLOW_UID=50000

POSTGRES_SUPERUSER_PASSWORD=change_me_pg_super
AIRFLOW_DB_PASSWORD=change_me_airflow_db
SUPERSET_DB_PASSWORD=change_me_superset_db
DWH_LOADER_PASSWORD=change_me_dwh_loader
DWH_READER_PASSWORD=change_me_dwh_reader

# Сгенерировать:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change_me_generate_fernet_key
# Сгенерировать: openssl rand -base64 42
AIRFLOW_SECRET_KEY=change_me_airflow_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin

SUPERSET_SECRET_KEY=change_me_openssl_rand_base64_42
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset_admin
