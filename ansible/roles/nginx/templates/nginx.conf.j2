# Управляется Ansible. Обратный прокси с TLS для Airflow и Superset.
events {}

http {
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 50m;

  server {
    listen 443 ssl;
    server_name {{ airflow_fqdn }};
    ssl_certificate     /etc/nginx/certs/platform.crt;
    ssl_certificate_key /etc/nginx/certs/platform.key;

    location / {
      proxy_pass http://airflow-webserver:8080;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }

  server {
    listen 443 ssl;
    server_name {{ superset_fqdn }};
    ssl_certificate     /etc/nginx/certs/platform.crt;
    ssl_certificate_key /etc/nginx/certs/platform.key;

    location / {
      proxy_pass http://superset:8088;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
