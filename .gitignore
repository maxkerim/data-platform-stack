# Secrets and local environment
.env
.venv/
ansible/group_vars/all/vault.yml
ansible/inventory/hosts.ini
ansible/collections/
*.retry
.vault_pass*

# Terraform state and local variables
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/crash.log
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/terraform.tfvars
terraform/**/crash.log

# Python
__pycache__/
*.pyc

# Local data: keep the folder structure, not the files
stand/data/inbox/*.xlsx
stand/data/inbox/archive/*
stand/data/inbox/rejected/*
!stand/data/inbox/archive/.gitkeep
!stand/data/inbox/rejected/.gitkeep
